MQTT_BROKER=your-hivemq-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_TOPIC=home/sensor/all
MQTT_TLS=1
DEVICE_ID=Ankara-RPi-01
SENSOR_ID=1
SENSOR_SOURCE=serial
SERIAL_FORMAT=arduino_text
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600
SERIAL_TIMEOUT=2
PUBLISH_INTERVAL=5
